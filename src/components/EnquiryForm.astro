---
/**
 * Enquiry form. Posts to FormSubmit with AJAX, the same mechanism HomeToClean and OurKampung use:
 * a `_subject` naming the site and page, a `_honey` honeypot, and a check of FormSubmit's `success`
 * field (it answers 200 even when it refuses a submission, e.g. before the inbox activates the form).
 *
 * The GA4 event fires only after FormSubmit confirms delivery, once per enquiry. It is named
 * `generate_lead` rather than `form_submit` because GA4's enhanced measurement already sends its own
 * `form_submit` on every submit attempt, delivered or not.
 */
import { ENQUIRY, type EnquiryService } from '../lib/site';

interface Props {
  service?: EnquiryService;
  heading: string;
  lede?: string;
  /** Anchor id for the section, so pages can link to it. */
  id?: string;
}

const { service = 'other', heading, lede, id = 'enquiry' } = Astro.props;
const services = Object.entries(ENQUIRY.services);
const config = { endpoint: ENQUIRY.endpoint, event: ENQUIRY.event };
---
<section class="enquiry" id={id} aria-labelledby={`${id}-title`} data-enquiry>
  <h2 id={`${id}-title`}>{heading}</h2>
  <p class="enquiry-lede">
    {lede ?? 'Tell us what you need and the team behind Junk to Clear will get you a quote.'}
  </p>

  <form class="enquiry-form" novalidate data-enquiry-form>
    <div class="enquiry-grid">
      <label>
        <span>What do you need?</span>
        <select name="Service" required>
          {services.map(([key, label]) => <option value={label} selected={key === service}>{label}</option>)}
        </select>
      </label>
      <label>
        <span>Property type</span>
        <select name="Property type" required>
          <option value="" selected disabled>Choose one</option>
          {ENQUIRY.propertyTypes.map((type) => <option value={type}>{type}</option>)}
        </select>
      </label>
      <label>
        <span>Area</span>
        <input name="Area" type="text" required autocomplete="address-level2" placeholder="e.g. Tampines, Holland Village" />
      </label>
      <label>
        <span>Move-out date <small>(or when you need it done, if you know)</small></span>
        <input name="Move-out date" type="date" />
      </label>
      <label>
        <span>Your name</span>
        <input name="Name" type="text" required autocomplete="name" />
      </label>
      <label>
        <span>Phone or WhatsApp</span>
        <input name="Phone or WhatsApp" type="tel" required inputmode="tel" autocomplete="tel" placeholder="e.g. 9123 4567" />
      </label>
    </div>

    {/* Honeypot. People never fill it in; bots usually do. */}
    <input class="enquiry-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <button class="btn btn-accent" type="submit" data-enquiry-submit>Send enquiry</button>
    <p class="enquiry-status" role="status" aria-live="polite" data-enquiry-status hidden></p>

    <p class="enquiry-notice">
      Your details go to the team behind Junk to Clear, HomeToMoved and HomeToClean. They pass them to whoever
      will quote for the job: Junk to Clear itself, or a vetted mover, cleaner or handyman. We use them only for
      this enquiry. <a href="/about/#privacy">How we handle your details</a>
    </p>
  </form>

  <div class="enquiry-success" hidden data-enquiry-success tabindex="-1">
    <p class="enquiry-success-title">Thank you. Your enquiry is on its way.</p>
    <p>The team will contact you on the number you gave. You don’t need to do anything else.</p>
  </div>
</section>

<script is:inline define:vars={{ config }}>
  (function () {
    var section = document.currentScript && document.currentScript.previousElementSibling;
    if (!section || !section.hasAttribute('data-enquiry')) return;
    var form = section.querySelector('[data-enquiry-form]');
    var submit = section.querySelector('[data-enquiry-submit]');
    var status = section.querySelector('[data-enquiry-status]');
    var success = section.querySelector('[data-enquiry-success]');

    function show(message, isError) {
      status.textContent = message;
      status.hidden = false;
      status.classList.toggle('is-error', !!isError);
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var data = {};
      new FormData(form).forEach(function (value, key) { data[key] = String(value).trim(); });

      // Silently "succeed" for bots rather than telling them they were caught.
      if (data._honey) { form.hidden = true; success.hidden = false; return; }
      delete data._honey;

      var digits = (data['Phone or WhatsApp'] || '').replace(/\D/g, '');
      if (!data['Property type'] || !data.Area || !data.Name || digits.length < 8) {
        show('Please choose a property type, and add your area, your name and a phone or WhatsApp number.', true);
        return;
      }

      var page = window.location.pathname;
      data._subject = 'Relocado enquiry: ' + data.Service + ' (' + page + ')';
      data._template = 'table';
      data.Site = 'relocado.asia';
      data.Page = window.location.origin + page;
      if (!data['Move-out date']) data['Move-out date'] = 'Not given';

      submit.disabled = true;
      show('Sending your enquiry…', false);

      fetch(config.endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (reply) {
          var ok = reply && (reply.success === true || reply.success === 'true');
          if (!ok) throw new Error((reply && reply.message) || 'rejected');
          if (typeof window.gtag === 'function') {
            window.gtag('event', config.event, { form_id: 'relocado_enquiry', service: data.Service, page_path: page });
          }
          form.hidden = true;
          success.hidden = false;
          success.focus({ preventScroll: true });
          success.scrollIntoView({ block: 'center', behavior: 'smooth' });
        })
        .catch(function () {
          submit.disabled = false;
          show('Sorry, that didn’t send. Please try again in a moment, or email hello@relocado.asia.', true);
        });
    });
  })();
</script>
