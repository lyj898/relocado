---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonicalURL = canonicalPath
  ? new URL(canonicalPath, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <header class="site">
    <div class="wrap site-header-row">
      <a class="logo" href="/">Reloc<span>a</span>do</a>
      <nav class="site-nav">
        <a href="/">Browse providers</a>
        <a href="/sg/">Singapore</a>
        <a href="/guides/">Guides</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site">
    <div class="wrap footer-row">
      <span>&copy; 2026 Relocado. Listings are researched independently and may be unclaimed by the business.</span>
      <a href="mailto:hello@relocado.asia">Claim a listing / contact us</a>
    </div>
  </footer>
</body>
</html>
