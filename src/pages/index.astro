---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COUNTRIES, COUNTRY_LABELS, COUNTRY_SLUGS, isOriginCountry } from '../lib/constants';
import { companies } from '../lib/companies';

const sgCorporateMobility = companies.filter(
  (c) => c.country === 'SG' && c.categories.includes('corporate_mobility')
).length;

const countryCounts = COUNTRIES.map((code) => ({
  code,
  label: COUNTRY_LABELS[code],
  slug: COUNTRY_SLUGS[code],
  origin: isOriginCountry(code),
  count: companies.filter((c) => c.country === code && c.categories.includes('corporate_mobility')).length,
})).filter((c) => c.code !== 'ID');

const totalProviders = countryCounts.reduce((sum, c) => sum + c.count, 0);
---
<BaseLayout
  title="Relocado — Corporate Mobility Providers for Relocating to Singapore"
  description="Find corporate global mobility and relocation management providers — in Singapore and in your home country — to manage your move to Singapore."
>
  <style>
    .hero {
      padding: 88px 0 72px;
      border-bottom: 1px solid var(--color-line);
    }
    .hero-kicker {
      display: inline-block;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-accent);
      font-weight: 600;
      margin-bottom: 18px;
    }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5vw, 3.8rem);
      line-height: 1.08;
      font-weight: 600;
      max-width: 800px;
      letter-spacing: -0.01em;
    }
    .hero p.lede {
      margin-top: 22px;
      font-size: 1.15rem;
      color: var(--color-ink-soft);
      max-width: 600px;
    }
    .hero-stat {
      margin-top: 28px;
      font-size: 0.95rem;
      color: var(--color-primary);
      font-weight: 500;
    }
    .destination-card {
      margin-top: 44px;
      max-width: 420px;
    }
    .destination-card .flag-label {
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-ink-soft);
    }
    .destination-card h3 {
      font-family: var(--font-display);
      font-size: 1.7rem;
      margin-top: 6px;
      font-weight: 500;
    }
    .destination-card .count {
      margin-top: 14px;
      font-size: 0.9rem;
      color: var(--color-primary);
      font-weight: 500;
    }

    .origin-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--color-line);
      border: 1px solid var(--color-line);
    }
    .origin-card h3 { font-size: 1.05rem; }
    @media (max-width: 900px) {
      .origin-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .how-it-works {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
    .how-it-works .step .num {
      font-family: var(--font-display);
      font-size: 1.6rem;
      color: var(--color-accent);
    }
    .how-it-works .step h3 {
      font-size: 1.05rem;
      margin-top: 10px;
    }
    .how-it-works .step p {
      margin-top: 8px;
      font-size: 0.92rem;
      color: var(--color-ink-soft);
    }
    @media (max-width: 720px) {
      .how-it-works { grid-template-columns: 1fr; }
    }
  </style>

  <section class="hero">
    <div class="wrap">
      <span class="hero-kicker">Corporate Mobility Directory · Destination: Singapore</span>
      <h1>Find the right corporate mobility partner to move your team to Singapore.</h1>
      <p class="lede">
        Relocado is a directory of global mobility and relocation management companies — researched from their own
        websites, organised by country — for HR and mobility teams (and the employees they're relocating) planning a
        move to Singapore.
      </p>
      <p class="hero-stat">{totalProviders} corporate mobility providers listed across {countryCounts.length} countries.</p>

      <a class="bordered-card destination-card" href="/sg/">
        <div class="flag-label">Destination</div>
        <h3>Providers based in Singapore</h3>
        <div class="count">{sgCorporateMobility} corporate mobility providers →</div>
      </a>
    </div>
  </section>

  <section class="section" id="find-provider">
    <div class="wrap">
      <div class="section-head">
        <h2>Find a provider in your home country</h2>
      </div>
      <p style="margin-top: -20px; margin-bottom: 32px; color: var(--color-ink-soft); max-width: 640px;">
        Companies based where your employees are moving from, with experience managing relocations into Singapore.
      </p>
      <div class="origin-grid">
        {countryCounts.filter((c) => c.origin).map((c) => (
          <a class="card origin-card" href={`/${c.slug}/`}>
            <h3>{c.label}</h3>
            <div class="cta">{c.count} providers →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="border-top: 1px solid var(--color-line);">
    <div class="wrap">
      <div class="section-head">
        <h2>How Relocado works</h2>
      </div>
      <div class="how-it-works">
        <div class="step">
          <div class="num">01</div>
          <h3>Pick a country</h3>
          <p>Browse providers based in Singapore, or in the country your employee is relocating from.</p>
        </div>
        <div class="step">
          <div class="num">02</div>
          <h3>Compare providers</h3>
          <p>Each listing has verified contact details, sourced directly from the company's own website.</p>
        </div>
        <div class="step">
          <div class="num">03</div>
          <h3>Reach out directly</h3>
          <p>Contact the provider yourself — phone, email, or their contact form. No middleman, no lead forms.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
