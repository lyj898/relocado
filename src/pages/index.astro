---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import { HUBS, HUB_ORDER, hubUrl, PLANNER_URL, DIRECTORY_URL, SISTER_SITES } from '../lib/site';
import { guidesForHub, urlFor } from '../lib/guides';

const leaving = await guidesForHub('leaving');
const counts = Object.fromEntries(
  await Promise.all(HUB_ORDER.map(async (key) => [key, (await guidesForHub(key)).length] as const))
);
---
<BaseLayout
  title="Relocado: Leaving Singapore, Arriving and Moving Back"
  description="Practical guides to moving in or out of Singapore: IR21 tax clearance, breaking a lease early, what to ship or clear out, and moving back."
>
  <section class="hero">
    <div class="wrap">
      <span class="hero-kicker">Moving in or out of Singapore</span>
      <h1>Leaving Singapore, arriving or moving back, done in the right order.</h1>
      <p class="lede">
        Plain-English guides to tax clearance, breaking a lease early, what your mover won’t ship, and what
        to do with everything that isn’t coming with you. Each one is checked against the official source.
      </p>
      <div class="hero-actions">
        <a class="btn btn-accent" href={PLANNER_URL}>Plan your departure</a>
        <a class="btn btn-outline" href="/leaving-singapore/checklist/">Read the leaving checklist</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-3">
        {HUB_ORDER.map((key) => (
          <a class="card" href={hubUrl(key)}>
            <div>
              <h3>{HUBS[key].title}</h3>
              <p>{HUBS[key].lede}</p>
            </div>
            <div class="cta">{counts[key]} {counts[key] === 1 ? 'guide' : 'guides'} →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="wrap">
      <div class="section-head">
        <h2>Leaving Singapore, step by step</h2>
        <a href={hubUrl('leaving')}>All leaving guides</a>
      </div>
      <div class="guide-list">
        {leaving.map((g, i) => <GuideCard href={urlFor(g)} title={g.data.title} summary={g.data.summary} step={i + 1} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2 class="split-title">Who ships your things overseas?</h2>
        <p>
          Relocado doesn’t move anything overseas. For the international leg, the directory lists Singapore’s
          international movers, relocation companies and pet relocation specialists. They’re listed
          alphabetically, from each company’s own website, and nobody pays to be there.
        </p>
        <a class="btn btn-outline" href={DIRECTORY_URL}>Browse the directory</a>
      </div>
      <div>
        <h2 class="split-title">Who runs Relocado</h2>
        <p>
          The OurKampung team, which also runs the two sites below. Where a guide needs one of them, it links
          there and says so. For everything else (tax, passes, leases, customs) it links to the official source.
        </p>
        <ul class="brand-list">
          {SISTER_SITES.map((b) => (
            <li><a href={b.url}>{b.name}</a>: {b.does}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
