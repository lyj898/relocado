---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CompanyListItem from '../../components/CompanyListItem.astro';
import {
  COUNTRIES,
  COUNTRY_LABELS,
  COUNTRY_SLUGS,
  CITIES,
  CATEGORIES,
  CATEGORY_LABELS,
  CATEGORY_DESCRIPTIONS,
  isOriginCountry,
  type CountryCode,
} from '../../lib/constants';
import { getCompaniesByCity, getCompaniesByCountry, countByCategory } from '../../lib/companies';

export function getStaticPaths() {
  return COUNTRIES.map((code) => ({ params: { country: COUNTRY_SLUGS[code] } }));
}

const { country: countrySlug } = Astro.params;
const countryCode = (COUNTRIES as readonly string[]).find(
  (code) => COUNTRY_SLUGS[code as CountryCode] === countrySlug
) as CountryCode;
const countryLabel = COUNTRY_LABELS[countryCode];
const cities = CITIES[countryCode];
const origin = isOriginCountry(countryCode);

// Origin countries: one category (corporate_mobility) spread across many cities — show a flat list.
const originList = origin
  ? getCompaniesByCountry(countryCode)
      .filter((c) => c.categories.includes('corporate_mobility'))
      .sort((a, b) => a.city.localeCompare(b.city) || a.name.localeCompare(b.name))
  : [];

// Destination countries: single-city ones show the category grid directly; multi-city show a city selector.
const soleCity = !origin && cities.length === 1 ? cities[0] : null;
const soleCityList = soleCity ? getCompaniesByCity(countryCode, soleCity.slug) : [];
const cityCounts = !origin
  ? cities.map((city) => ({ ...city, count: getCompaniesByCity(countryCode, city.slug).length }))
  : [];
---
<BaseLayout
  title={
    origin
      ? `Corporate Mobility Providers in ${countryLabel} | Relocado`
      : `Relocation Services in ${countryLabel} | Relocado`
  }
  description={
    origin
      ? `${originList.length} corporate mobility and global relocation providers in ${countryLabel} that help employers move employees to Singapore.`
      : `Browse movers, visa consultants, real estate agents, and other relocation service providers in ${countryLabel}.`
  }
>
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: countryLabel }]} />
  </div>

  <div class="page-header">
    <div class="wrap">
      <span class="kicker">{countryLabel}</span>
      <h1>{origin ? `Corporate mobility providers in ${countryLabel}` : `Relocation services in ${countryLabel}`}</h1>
      <p class="lede">
        {origin
          ? `${originList.length} companies based in ${countryLabel} that manage corporate relocation and global mobility programs for employees moving to Singapore.`
          : soleCity
            ? `${soleCityList.length} providers listed across ${CATEGORIES.length} categories.`
            : `Choose a city to see providers listed there.`}
      </p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      {origin ? (
        originList.length > 0 ? (
          <div class="company-list">
            {originList.map((company) => (
              <CompanyListItem
                company={company}
                href={`/${countrySlug}/${cities.find((c) => c.label === company.city)?.slug}/corporate_mobility/${company.slug}/`}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <p>No corporate mobility providers listed in {countryLabel} yet.</p>
          </div>
        )
      ) : soleCity ? (
        <div class="grid-3">
          {CATEGORIES.map((cat) => (
            <a class="card" href={`/${countrySlug}/${soleCity.slug}/${cat}/`}>
              <div>
                <h3>{CATEGORY_LABELS[cat]}</h3>
                <p>{CATEGORY_DESCRIPTIONS[cat]}</p>
              </div>
              <div class="cta">{countByCategory(soleCityList, cat)} providers →</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="grid-2">
          {cityCounts.map((city) => (
            <a class="bordered-card" href={`/${countrySlug}/${city.slug}/`}>
              <h3 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 500;">{city.label}</h3>
              <div style="margin-top: 14px; font-size: 0.9rem; color: var(--color-primary); font-weight: 500;">{city.count} listed providers</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
