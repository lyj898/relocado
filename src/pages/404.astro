---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HUBS, HUB_ORDER, hubUrl, DIRECTORY_URL } from '../lib/site';
---
<BaseLayout
  title="Page Not Found | Relocado"
  description="This page doesn’t exist any more. Relocado is now a guide to leaving Singapore, arriving and moving back, with a Singapore directory."
  noindex
>
  <div class="page-header">
    <div class="wrap">
      <span class="kicker">Page not found</span>
      <h1>This page doesn’t exist any more</h1>
      <p class="lede">
        Relocado used to be a worldwide directory of relocation companies. It’s now a practical guide to
        moving in or out of Singapore, so many old addresses no longer lead anywhere.
      </p>
    </div>
  </div>
  <section class="section">
    <div class="wrap">
      <div class="grid-3">
        {HUB_ORDER.map((key) => (
          <a class="card" href={hubUrl(key)}>
            <div>
              <h3>{HUBS[key].title}</h3>
              <p>{HUBS[key].lede}</p>
            </div>
            <div class="cta">Open →</div>
          </a>
        ))}
      </div>
      <p class="not-found-more">
        Looking for a Singapore relocation company? <a href={DIRECTORY_URL}>Browse the directory</a>.
      </p>
    </div>
  </section>
</BaseLayout>
