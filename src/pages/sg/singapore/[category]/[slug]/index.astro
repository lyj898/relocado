---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CompanyProfile from '../../../../../components/CompanyProfile.astro';
import { CATEGORIES, CATEGORY_LABELS, type Category } from '../../../../../lib/constants';
import { getCompaniesByCategory } from '../../../../../lib/companies';

export function getStaticPaths() {
  return CATEGORIES.flatMap((category) => {
    const list = getCompaniesByCategory('SG', 'singapore', category);
    return list.map((company) => ({ params: { category, slug: company.slug }, props: { company } }));
  });
}

const { category } = Astro.params as { category: Category };
const { company } = Astro.props;
const label = CATEGORY_LABELS[category];
---
<BaseLayout
  title={`${company.name} — ${label} in Singapore | Relocado`}
  description={company.description || `${company.name} is a ${label.toLowerCase()} provider in Singapore.`}
>
  <CompanyProfile
    company={company}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Singapore', href: '/sg/' },
      { label, href: `/sg/singapore/${category}/` },
      { label: company.name },
    ]}
  />
</BaseLayout>
