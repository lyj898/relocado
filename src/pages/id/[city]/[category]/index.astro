---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CategoryListing from '../../../../components/CategoryListing.astro';
import { CATEGORIES, CATEGORY_LABELS, CITIES, type Category } from '../../../../lib/constants';
import { getCompaniesByCategory } from '../../../../lib/companies';

export function getStaticPaths() {
  return CITIES.ID.flatMap((city) =>
    CATEGORIES.map((category) => ({ params: { city: city.slug, category } }))
  );
}

const { city: citySlug, category } = Astro.params as { city: string; category: Category };
const cityInfo = CITIES.ID.find((c) => c.slug === citySlug)!;
const list = getCompaniesByCategory('ID', citySlug, category);
const label = CATEGORY_LABELS[category];
---
<BaseLayout
  title={`${label} in ${cityInfo.label} | Relocado`}
  description={`Browse ${list.length} ${label.toLowerCase()} providers in ${cityInfo.label}, Indonesia, part of Relocado's relocation directory.`}
>
  <CategoryListing
    category={category}
    cityLabel={cityInfo.label}
    companies={list}
    basePath={`/id/${citySlug}/${category}`}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Indonesia', href: '/id/' },
      { label: cityInfo.label, href: `/id/${citySlug}/` },
      { label },
    ]}
  />
</BaseLayout>
