---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CompanyProfile from '../../../../../components/CompanyProfile.astro';
import { CATEGORIES, CATEGORY_LABELS, CITIES, type Category } from '../../../../../lib/constants';
import { getCompaniesByCategory } from '../../../../../lib/companies';

export function getStaticPaths() {
  return CITIES.ID.flatMap((city) =>
    CATEGORIES.flatMap((category) => {
      const list = getCompaniesByCategory('ID', city.slug, category);
      return list.map((company) => ({
        params: { city: city.slug, category, slug: company.slug },
        props: { company },
      }));
    })
  );
}

const { city: citySlug, category } = Astro.params as { city: string; category: Category };
const cityInfo = CITIES.ID.find((c) => c.slug === citySlug)!;
const { company } = Astro.props;
const label = CATEGORY_LABELS[category];
---
<BaseLayout
  title={`${company.name} — ${label} in ${cityInfo.label} | Relocado`}
  description={company.description || `${company.name} is a ${label.toLowerCase()} provider in ${cityInfo.label}, Indonesia.`}
>
  <CompanyProfile
    company={company}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Indonesia', href: '/id/' },
      { label: cityInfo.label, href: `/id/${citySlug}/` },
      { label, href: `/id/${citySlug}/${category}/` },
      { label: company.name },
    ]}
  />
</BaseLayout>
