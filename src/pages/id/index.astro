---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CITIES } from '../../lib/constants';
import { getCompaniesByCity } from '../../lib/companies';

const cities = CITIES.ID.map((city) => ({
  ...city,
  count: getCompaniesByCity('ID', city.slug).length,
}));
---
<BaseLayout
  title="Relocation Services in Indonesia | Relocado"
  description="Browse movers, visa consultants, real estate agents, and other relocation service providers in Jakarta and Bali, Indonesia."
>
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Indonesia' }]} />
  </div>

  <div class="page-header">
    <div class="wrap">
      <span class="kicker">Indonesia</span>
      <h1>Relocation services in Indonesia</h1>
      <p class="lede">Choose a city to see providers listed there.</p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        {cities.map((city) => (
          <a class="bordered-card" href={`/id/${city.slug}/`}>
            <h3 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 500;">{city.label}</h3>
            <div style="margin-top: 14px; font-size: 0.9rem; color: var(--color-primary); font-weight: 500;">{city.count} listed providers</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
